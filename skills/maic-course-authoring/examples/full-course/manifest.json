  "scenes": [
    {
      "type": "slide",
      "title": "什么是三相点",
      "order": 1,
      "content": {
        "type": "slide",
        "schemaVersion": 1,
        "canvas": {
          "id": "canvas-1",
          "viewportSize": 1000,
          "viewportRatio": 0.5625,
          "theme": {
            "backgroundColor": "#FFFFFF",
            "themeColors": [
              "#4F8EF7",
              "#333333"
            ],
            "fontColor": "#333333",
            "fontName": "Microsoft YaHei"
          },
          "background": {
            "type": "solid",
            "color": "#FFFFFF"
          },
          "elements": [
            {
              "id": "p01_text_title",
              "type": "text",
              "left": 60,
              "top": 60,
              "width": 880,
              "height": 70,
              "rotate": 0,
              "content": "<p style=\"font-size:32px;\"><strong>水的三相点</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333"
            },
            {
              "id": "p01_text_definition",
              "type": "text",
              "left": 60,
              "top": 170,
              "width": 880,
              "height": 130,
              "rotate": 0,
              "content": "<p style=\"font-size:18px;\">• 气、液、固三态共存的唯一温度和压力组合</p><p style=\"font-size:18px;\">• 温度 273.16 K（0.01 °C）</p><p style=\"font-size:18px;\">• 压力 611.657 Pa</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333"
            },
            {
              "id": "p01_shape_divider",
              "type": "shape",
              "left": 60,
              "top": 330,
              "width": 880,
              "height": 3,
              "rotate": 0,
              "viewBox": [
                1,
                1
              ],
              "path": "M 0 0 L 1 0 L 1 1 L 0 1 Z",
              "fill": "#CCCCCC",
              "fixedRatio": false
            },
            {
              "id": "p01_text_history",
              "type": "text",
              "left": 60,
              "top": 360,
              "width": 880,
              "height": 106,
              "rotate": 0,
              "content": "<p style=\"font-size:18px;\">1967 年国际计量大会用它定义开尔文；</p><p style=\"font-size:18px;\">2019 年 SI 修订后改由玻尔兹曼常数定义，三相点转为重要固定点。</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333"
            }
          ]
        }
      },
      "actions": [
        {
          "id": "p01_a1",
          "type": "speech",
          "text": "我们先看三相点的定义：气、液、固三态共存的唯一温度和压力组合。",
          "audioRef": "audio/audio-1.mp3"
        },
        {
          "id": "p01_a2",
          "type": "spotlight",
          "elementId": "p01_text_definition"
        },
        {
          "id": "p01_a3",
          "type": "speech",
          "text": "温度是 273.16 K，压力是 611.657 Pa。这两个数字请记牢。"
        },
        {
          "id": "p01_a4",
          "type": "laser",
          "elementId": "p01_text_history"
        },
        {
          "id": "p01_a5",
          "type": "discussion",
          "topic": "小林，三相点和冰点一样吗？说说你的理解。",
          "agentIndex": 1
        }
      ]
    },
    {
      "type": "quiz",
      "title": "小测：三相点的温度",
      "order": 2,
      "content": {
        "type": "quiz",
        "questions": [
          {
            "id": "p02_q1",
            "type": "single",
            "question": "水的三相点温度是多少？",
            "options": [
              {
                "label": "273.16 K",
                "value": "A"
              },
              {
                "label": "273.15 K",
                "value": "B"
              },
              {
                "label": "373.13 K",
                "value": "C"
              }
            ],
            "answer": [
              "A"
            ],
            "analysis": "三相点是 273.16 K；273.15 K 是标准大气压下的冰点，两者相差 0.01 K。",
            "hasAnswer": true,
            "points": 1
          },
          {
            "id": "p02_q2",
            "type": "short_answer",
            "question": "为什么 2019 年 SI 修订后，三相点不再用于定义开尔文？请用一两句话说明。",
            "analysis": "修订后开尔文由玻尔兹曼常数的固定数值定义，不再依赖任何物质的性质；三相点仍是重要的固定点。",
            "hasAnswer": false,
            "points": 2
          }
        ]
      },
      "actions": [
        {
          "id": "p02_a1",
          "type": "speech",
          "text": "来做两道题，检查一下刚才的要点。"
        }
      ]
    },
    {
      "type": "interactive",
      "title": "互动：调节压力观察相变",
      "order": 3,
      "content": {
        "type": "interactive",
        "url": "",
        "html": "<!doctype html><html><head><meta charset=\"utf-8\"><style>body{font-family:system-ui;margin:24px;background:#fff;color:#333}input[type=range]{width:100%}#state{margin-top:16px;padding:12px;border-radius:8px;background:#eef4fb}.stat{display:inline-block;margin-right:24px;padding:8px 12px;border-radius:6px;background:#f3f4f6}</style></head><body><h3>调节压力，观察水的相态（温度固定在 0.01 °C）</h3><input id=\"pressure\" type=\"range\" min=\"100\" max=\"2000\" value=\"611\" step=\"1\"><p>压力：<b id=\"pressure-value\">611</b> Pa</p><div id=\"state\">—</div><span class=\"stat\" id=\"stat-pressure\">压力读数</span><span class=\"stat\" id=\"stat-phase\">相态判定</span><button id=\"apply-preset\">恢复三相点压力</button><script>const P_TRIPLE=611.657;const p=document.getElementById('pressure'),pv=document.getElementById('pressure-value'),st=document.getElementById('state');function upd(){const v=+p.value;pv.textContent=v;st.textContent=v<P_TRIPLE?'气态（低于三相点压力，液态不存在）':'气液固三相共存或液态（达到/超过三相点压力）';}p.addEventListener('input',upd);document.getElementById('apply-preset').addEventListener('click',()=>{p.value=611;upd();});upd();</script></body></html>",
        "widgetType": "simulation",
        "widgetConfig": {
          "type": "simulation",
          "concept": "pressure_vs_phase",
          "description": "压力-相态交互模拟器：在 0.01 °C 下调节压力，观察低于三相点压力时液态消失。",
          "variables": [
            {
              "name": "pressure",
              "min": 100,
              "max": 2000,
              "default": 611,
              "step": 1,
              "unit": "Pa",
              "label": "环境压力"
            }
          ],
          "presets": [
            {
              "name": "三相点压力",
              "variables": {
                "pressure": 611
              }
            },
            {
              "name": "远低于三相点",
              "variables": {
                "pressure": 200
              }
            },
            {
              "name": "标准大气压",
              "variables": {
                "pressure": 101325
              }
            }
          ]
        }
      },
      "actions": [
        {
          "id": "p03_a1",
          "type": "speech",
          "text": "拖动滑块改变压力，看看液态在什么时候才会出现。",
          "audioRef": "audio/audio-2.mp3"
        },
        {
          "id": "p03_a2",
          "type": "widget_setState",
          "state": {
            "pressure": 611
          },
          "content": "先把压力设回三相点压力，让三态共存。"
        },
        {
          "id": "p03_a3",
          "type": "widget_highlight",
          "target": "#stat-pressure",
          "content": "这是当前的压力读数。"
        },
        {
          "id": "p03_a4",
          "type": "widget_highlight",
          "target": "#stat-phase",
          "content": "这里会实时显示相态判定结果。"
        },
        {
          "id": "p03_a5",
          "type": "widget_setState",
          "state": {
            "pressure": 200
          },
          "content": "把压力降到 200 Pa——低于三相点压力，液态消失了。"
        },
        {
          "id": "p03_a6",
          "type": "widget_highlight",
          "target": "#apply-preset",
          "content": "随时可以点这里恢复三相点压力。"
        }
      ]
    },
