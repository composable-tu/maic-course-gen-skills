            {
              "id": "text_title",
              "type": "text",
              "left": 60,
              "top": 60,
              "width": 880,
              "height": 76,
              "rotate": 0,
              "content": "<p style=\"font-size:36px;\"><strong>水的三相点与常见温度点</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333"
            },
            {
              "id": "text_subtitle",
              "type": "text",
              "left": 60,
              "top": 150,
              "width": 880,
              "height": 58,
              "rotate": 0,
              "content": "<p style=\"font-size:24px;\">三相点、冰点与沸点——三个容易混淆的温度</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333"
            },
            {
              "id": "text_body",
              "type": "text",
              "left": 60,
              "top": 240,
              "width": 880,
              "height": 170,
              "rotate": 0,
              "content": "<p style=\"font-size:18px;\">• 三相点：273.16 K，压力 611.657 Pa</p><p style=\"font-size:18px;\">• 冰点：273.15 K，标准大气压下</p><p style=\"font-size:18px;\">• 沸点：373.13 K，标准大气压下</p><p style=\"font-size:18px;\">• 三者相差虽小，物理意义完全不同</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333"
            },
            {
              "id": "text_caption",
              "type": "text",
              "left": 60,
              "top": 440,
              "width": 880,
              "height": 43,
              "rotate": 0,
              "content": "<p style=\"font-size:14px;\">数据来源：材料《水的三相点》</p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#888888"
            }
          ]
        }
      },
      "actions": [
        { "id": "a1", "type": "speech", "text": "这一页只用了文本元素。注意字号层级：36、24、18、14。" },
        { "id": "a2", "type": "spotlight", "elementId": "text_body" }
      ]
    },
