          "elements": [
            {
              "id": "text_head",
              "type": "text",
              "left": 60,
              "top": 60,
              "width": 880,
              "height": 70,
              "rotate": 0,
              "content": "<p style=\"font-size:32px;\"><strong>用公式与代码表达定量关系</strong></p>",
              "defaultFontName": "Microsoft YaHei",
              "defaultColor": "#333333"
            },
            {
              "id": "latex_clausius",
              "type": "latex",
              "left": 60,
              "top": 140,
              "width": 880,
              "height": 90,
              "rotate": 0,
              "latex": "\\ln\\dfrac{P_2}{P_1} = -\\dfrac{\\Delta H_{\\text{vap}}}{R}\\left(\\dfrac{1}{T_2} - \\dfrac{1}{T_1}\\right)"
            },
            {
              "id": "code_antoine",
              "type": "code",
              "left": 60,
              "top": 260,
              "width": 880,
              "height": 200,
              "rotate": 0,
              "language": "python",
              "lines": [
                { "id": "L1", "content": "# Antoine 方程：由温度计算饱和蒸气压（kPa）" },
                { "id": "L2", "content": "def antoine(a, b, c, t_celsius):" },
                { "id": "L3", "content": "    return 10 ** (a - b / (t_celsius + c))" },
                { "id": "L4", "content": "" },
                { "id": "L5", "content": "print(antoine(8.07131, 1730.63, 233.426, 25))" }
              ]
            }
          ]
        }
      },
      "actions": [{ "id": "a1", "type": "speech", "text": "同一个定量关系，公式给推导，代码给可运行的实现。" }]
